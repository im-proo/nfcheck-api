# ==========================================
# NFCheck API Environment Configuration
# ==========================================

# Port to bind to (Render sets this automatically)
PORT=8080

# TCP listen address override (optional, defaults to 0.0.0.0:$PORT)
# ADDR=0.0.0.0:8080

# Number of concurrent worker goroutines (default: 4)
# Increase for higher throughput (e.g., 8, 16, 50, 100) or decrease for low-memory tiers
WORKERS=4

# Maximum checks allowed per minute (0 = unlimited, default = 1000)
RATE_PER_MIN=1000

# Structured JSON logging for production observability (true / false)
JSON_LOG=false
